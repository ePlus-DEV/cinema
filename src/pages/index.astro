---
import BaseLayout from '../layouts/BaseLayout.astro';
import HomeHero from '../components/HomeHero.astro';
import MovieRail from '../components/MovieRail.astro';
import TrailerModal from '../components/TrailerModal.astro';
import FeaturedReviews from '../components/FeaturedReviews.astro';
import LiveCinemaGrid from '../components/LiveCinemaGrid.astro';
import MomoShowtimeList from '../components/MomoShowtimeList.astro';
---
<BaseLayout active="home" title="ePlus Cinema | Phim đang chiếu, lịch chiếu và rạp tại TP.HCM" description="Khám phá phim đang chiếu, phim sắp chiếu và tra cứu lịch chiếu theo ngày, cụm rạp tại TP. Hồ Chí Minh. ePlus Cinema không bán vé." canonicalPath="/" seoIndexable />
  <HomeHero />

  <nav class="home-paths" aria-label="Lối tắt khám phá phim">
    <div class="container home-paths__inner">
      <a href="#phim-dang-chieu" class="home-paths__item">
        <span class="home-paths__number" aria-hidden="true">01</span>
        <span class="home-paths__text"><strong>Phim đang chiếu</strong><small>Khám phá các bộ phim nổi bật</small></span>
        <span class="home-paths__arrow" aria-hidden="true">↗</span>
      </a>
      <a href="#phim-sap-chieu" class="home-paths__item">
        <span class="home-paths__number" aria-hidden="true">02</span>
        <span class="home-paths__text"><strong>Phim sắp chiếu</strong><small>Khám phá phim sắp ra mắt</small></span>
        <span class="home-paths__arrow" aria-hidden="true">↗</span>
      </a>
      <a href="#lich-chieu" class="home-paths__item">
        <span class="home-paths__number" aria-hidden="true">03</span>
        <span class="home-paths__text"><strong>Lịch chiếu</strong><small>Tìm rạp và giờ chiếu phù hợp</small></span>
        <span class="home-paths__arrow" aria-hidden="true">↗</span>
      </a>
    </div>
  </nav>

  <section class="section section--dark" id="phim-dang-chieu">
    <div class="container">
      <div class="section-heading section-heading--centered section-heading--on-dark">
        <div>
          <span class="eyebrow">ĐANG CHIẾU TẠI RẠP</span>
          <h2>Phim đang chiếu</h2>
          <p>Những bộ phim được khán giả chấm điểm nhiều nhất, cập nhật mỗi ngày.</p>
        </div>
      </div>
      <MovieRail status="now" limit={24} ranked />
      <div class="section-cta"><a class="button button--light" href="/phim-dang-chieu">Xem tất cả phim đang chiếu <span>↗</span></a></div>
    </div>
  </section>

  <section class="section container" id="phim-sap-chieu">
    <div class="section-heading section-heading--centered">
      <div>
        <span class="eyebrow">DÀNH CHO NGƯỜI MÊ PHIM</span>
        <h2>Phim sắp chiếu</h2>
        <p>Thêm vài bộ phim vào danh sách mong chờ của bạn.</p>
      </div>
    </div>
    <MovieRail status="soon" limit={24} />
    <div class="section-cta"><a class="button button--dark" href="/phim-sap-chieu">Xem tất cả phim sắp chiếu <span>↗</span></a></div>
  </section>

  <section class="section section--tinted" id="lich-chieu">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">LÊN KẾ HOẠCH XEM PHIM</span><h2>Khung giờ dành cho bạn</h2><p>Chọn ngày, tìm rạp và xem các khung giờ đang được cung cấp.</p></div>
        <a class="section-link" href="/lich-chieu">Tra cứu đầy đủ <span>↗</span></a>
      </div>
      <div class="schedule-shell">
        <div class="schedule-shell__top"><div><strong>Lịch chiếu tại <span data-city-name>TP. Hồ Chí Minh</span></strong><span>Lịch chiếu tham khảo · Bấm giờ để xem sơ đồ ghế</span></div><span class="schedule-shell__city">⌖ <span data-city-name>TP. Hồ Chí Minh</span></span></div>
        <MomoShowtimeList />
        <div class="schedule-shell__footer"><a href="/lich-chieu" class="button button--outline">Tra cứu tất cả suất chiếu <span>↗</span></a></div>
      </div>
    </div>
  </section>

  <section class="section container" id="danh-gia-noi-bat">
    <div class="section-heading section-heading--centered">
      <div>
        <span class="eyebrow">KHÁN GIẢ NÓI GÌ</span>
        <h2>Bình luận nổi bật</h2>
        <p>Cảm nhận thật từ khán giả đã xem phim tại rạp.</p>
      </div>
    </div>
    <FeaturedReviews />
    <div class="section-cta"><a class="button button--dark" href="/danh-gia">Xem thêm đánh giá <span>↗</span></a></div>
  </section>

  <section class="section section--theaters">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">THẾ GIỚI RẠP CHIẾU</span><h2>Khám phá cụm rạp</h2><p>Các cụm rạp tại TP. Hồ Chí Minh — dữ liệu cập nhật mỗi ngày.</p></div>
        <a class="section-link" href="/lich-chieu">Xem lịch theo rạp <span>↗</span></a>
      </div>
      <LiveCinemaGrid limit={8} />
    </div>
  </section>

  <TrailerModal />
</BaseLayout>

<style>
  .section--dark { background: var(--navy); }
  .section-heading--centered { justify-content: center; text-align: center; }
  .section-heading--centered .eyebrow { display: inline-block; }
  .section-heading--on-dark h2 { color: #fff; }
  .section-heading--on-dark p { color: #93a1b5; }
  .section-cta { display: flex; justify-content: center; margin-top: 26px; }
  .button--light { background: #fff; color: var(--navy); border-radius: 999px; padding: 14px 24px; font-size: 12px; }
  .button--dark { background: var(--navy); color: #fff; border-radius: 999px; padding: 14px 24px; font-size: 12px; }
</style>
