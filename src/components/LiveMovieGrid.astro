---
/** Live card grid shared by home and both real movie catalog pages. */
interface Props { status: 'now' | 'soon'; limit?: number; searchable?: boolean; }
const { status, limit = 12, searchable = false } = Astro.props;
---
<div class="live-movie-catalog" data-live-movie-catalog data-status={status} data-limit={limit}>
  {searchable && <div class="live-catalog__tools">
    <label class="catalog__search">
      <span aria-hidden="true">⌕</span>
      <input type="search" aria-label="Tìm phim" placeholder="Tìm theo tên phim..." data-live-movie-search />
    </label>
    <span class="live-catalog__count" data-live-movie-count aria-live="polite">Đang tải phim…</span>
  </div>}
  <div class="movie-grid" data-live-movies aria-busy="true">
    {Array.from({ length: Math.min(limit, 12) }).map(() => (
      <div class="movie-card skeleton" aria-hidden="true">
        <div class="skeleton__poster"></div>
        <div class="skeleton__line"></div>
        <div class="skeleton__line skeleton__line--short"></div>
      </div>
    ))}
  </div>
  <p class="empty-results" data-live-movie-empty hidden>Không tìm thấy phim phù hợp. Hãy thử từ khóa khác.</p>
</div>
<script>
  import { loadAllFilms } from '../lib/momo-client.js';

  const normalize = (value) => String(value || '').normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '').toLocaleLowerCase('vi').trim();

  function movieCard(film, status) {
    const card = document.createElement('a');
    card.className = 'movie-card live-movie-card';
    card.href = import.meta.env.BASE_URL + 'phim/chi-tiet/?id=' + encodeURIComponent(film.Id);
    card.setAttribute('aria-label', 'Xem chi tiết phim ' + (film.Title || ''));
    card.dataset.search = normalize((film.Title || '') + ' ' + (film.TitleEn || ''));
    const poster = document.createElement('div');
    poster.className = 'live-poster';
    const badge = document.createElement('span');
    badge.className = 'live-poster__badge';
    badge.textContent = status === 'now' ? 'Đang chiếu' : 'Sắp chiếu';
    poster.append(badge);
    const posterUrl = film.GraphicUrl || film.ImageUrl;
    if (posterUrl) {
      const img = document.createElement('img');
      img.src = posterUrl;
      img.alt = 'Poster phim ' + (film.Title || '');
      img.loading = 'lazy';
      poster.append(img);
    }
    const info = document.createElement('div');
    info.className = 'movie-card__info';
    const head = document.createElement('div');
    head.className = 'movie-card__head';
    const title = document.createElement('h3');
    title.textContent = film.Title || 'Chưa có tên phim';
    head.append(title);
    if (film.ApiRatingFormat) {
      const age = document.createElement('span');
      age.className = 'age-badge';
      age.textContent = film.ApiRatingFormat;
      head.append(age);
    }
    const meta = document.createElement('p');
    meta.textContent = [film.ApiGenreName, film.Duration ? film.Duration + ' phút' : ''].filter(Boolean).join(' · ');
    const statusText = document.createElement('span');
    statusText.className = 'movie-card__status';
    statusText.textContent = status === 'now' ? 'Chi tiết & lịch chiếu ↗' :
      'Chi tiết phim ↗';
    info.append(head, meta, statusText);
    card.append(poster, info);
    return card;
  }

  document.querySelectorAll('[data-live-movie-catalog]').forEach(async (root) => {
    const grid = root.querySelector('[data-live-movies]');
    const search = root.querySelector('[data-live-movie-search]');
    const count = root.querySelector('[data-live-movie-count]');
    const empty = root.querySelector('[data-live-movie-empty]');
    const status = root.dataset.status === 'soon' ? 'soon' : 'now';
    const max = Math.max(1, Number(root.dataset.limit) || 12);
    if (search) search.value = new URLSearchParams(location.search).get('q') || '';

    function filterCards() {
      const query = normalize(search?.value);
      const cards = [...grid.querySelectorAll('.movie-card:not(.skeleton)')];
      let visible = 0;
      for (const card of cards) {
        const matches = !query || (card.dataset.search || '').includes(query);
        card.hidden = !matches;
        if (matches) visible++;
      }
      if (count) count.textContent = visible + ' phim';
      if (empty) empty.hidden = visible > 0;
    }

    async function load() {
      grid.setAttribute('aria-busy', 'true');
      try {
        const films = (await loadAllFilms(status)).slice(0, max);
        if (!films.length) throw new Error('Nguồn dữ liệu chưa có phim ở trạng thái này');
        grid.replaceChildren(...films.map((film) => movieCard(film, status)));
        filterCards();
      } catch (error) {
        grid.replaceChildren();
        if (empty) empty.hidden = true;
        const message = document.createElement('p');
        message.className = 'live-status';
        message.textContent = 'Không tải được danh sách phim (' + error.message + '). ';
        const retry = document.createElement('button');
        retry.type = 'button';
        retry.textContent = 'Thử lại';
        retry.addEventListener('click', load);
        message.append(retry);
        grid.append(message);
        if (count) count.textContent = 'Chưa tải được phim';
      } finally {
        grid.setAttribute('aria-busy', 'false');
      }
    }

    search?.addEventListener('input', filterCards);
    load();
  });
</script>
