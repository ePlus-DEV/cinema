---
import BaseLayout from '../layouts/BaseLayout.astro';
import LiveMovieGrid from '../components/LiveMovieGrid.astro';
import TrailerModal from '../components/TrailerModal.astro';
---
<BaseLayout title="Phim sắp chiếu tại TP.HCM | ePlus Cinema" description="Khám phá danh sách phim sắp chiếu và thông tin khởi chiếu dự kiến tại TP. Hồ Chí Minh; dữ liệu chỉ mang tính tham khảo." active="soon" canonicalPath="/phim-sap-chieu/" seoIndexable breadcrumbs={[{ name: 'Trang chủ', path: '/' }, { name: 'Phim sắp chiếu', path: '/phim-sap-chieu/' }]} />
  <section class="page-hero"><div class="container">
    <div class="breadcrumbs"><a href="/">Trang chủ</a><span>/</span><span>Phim sắp chiếu</span></div>
    <span class="eyebrow">SẮP RA RẠP</span>
    <h1>Phim sắp chiếu <span class="title-spark">✦</span></h1>
    <p>Khám phá những bộ phim sắp công chiếu với thông tin từ nguồn trực tiếp.</p>
  </div></section>
  <section class="section container catalog">
    <LiveMovieGrid status="soon" limit={100} searchable />
    <TrailerModal />
    <p class="catalog__footnote">Ngày công chiếu và thông tin có thể thay đổi; ePlus không bán vé.</p>
  </section>
</BaseLayout>
