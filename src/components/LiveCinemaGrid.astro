---
import { cinemas, routeForCinema } from '../lib/cinema-catalog';
import { CHAIN_LOGOS, CHAIN_SHORT_LABELS } from '../lib/cinema-logos.js';
interface Props { limit?: number; searchable?: boolean; }
const { limit = 8, searchable = false } = Astro.props;
const rows = cinemas.slice(0, limit);
const base = import.meta.env.BASE_URL;
const normalize = (text: string) => text.normalize('NFD')
  .replace(/[\u0300-\u036f]/g, '').toLowerCase();
---
<div class="live-cinema-catalog" data-live-cinema-catalog>
  {searchable && <div class="live-catalog__tools">
    <label class="catalog__search">
      <span aria-hidden="true">⌕</span>
      <input type="search" aria-label="Tìm rạp" placeholder="Tìm rạp, hệ thống hoặc địa chỉ..." data-live-cinema-search />
    </label>
    <span class="live-catalog__count" data-live-cinema-count aria-live="polite">{rows.length} cụm rạp</span>
  </div>}
  <div class="cinema-grid" data-live-cinemas aria-busy="false">
    {rows.map((cinema) => <a
      class="cinema-tile cinema-tile--live"
      href={routeForCinema(cinema, base)}
      aria-label={'Xem chi tiết rạp ' + cinema.name}
      data-search={normalize(cinema.name + ' ' + cinema.chain + ' ' + cinema.address)}
    >
      <span class="chain-logo">
        {CHAIN_LOGOS[cinema.chainId] && <img src={CHAIN_LOGOS[cinema.chainId]} alt="" loading="lazy" decoding="async" />}
        <span class="chain-logo__fallback">{CHAIN_SHORT_LABELS[cinema.chainId] || cinema.chain || 'RẠP'}</span>
      </span>
      <span class="cinema-tile__body">
        <strong>{cinema.name}</strong>
        <small>{cinema.chain} · {cinema.address || 'TP. Hồ Chí Minh'}</small>
      </span>
      <span class="cinema-tile__arrow" aria-hidden="true">↗</span>
    </a>)}
  </div>
  <p class="empty-results" data-live-cinema-empty hidden>Không tìm thấy rạp phù hợp.</p>
  {rows.length === 0 && <p class="live-status">Chưa có dữ liệu cụm rạp trong bản cập nhật gần nhất.</p>}
</div>
<script>
  const normalize = (value: string) => String(value || '').normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
  document.querySelectorAll<HTMLElement>('[data-live-cinema-catalog]').forEach((root) => {
    const grid = root.querySelector<HTMLElement>('[data-live-cinemas]');
    const search = root.querySelector<HTMLInputElement>('[data-live-cinema-search]');
    const count = root.querySelector<HTMLElement>('[data-live-cinema-count]');
    const empty = root.querySelector<HTMLElement>('[data-live-cinema-empty]');
    if (!grid) return;
    // The wordmark is readable when CDN assets fail.
    grid.querySelectorAll<HTMLImageElement>('.chain-logo img').forEach((image) => {
      const fallback = image.nextElementSibling as HTMLElement | null;
      image.addEventListener('load', () => { if (fallback) fallback.hidden = true; });
      image.addEventListener('error', () => image.remove());
      if (image.complete && image.naturalWidth) { if (fallback) fallback.hidden = true; }
    });
    const filter = () => {
      const q = normalize(search?.value || '');
      let visible = 0;
      const cards = grid.querySelectorAll<HTMLElement>('.cinema-tile--live');
      cards.forEach((card) => {
        card.hidden = !!q && !(card.dataset.search || '').includes(q);
        if (!card.hidden) visible++;
      });
      if (count) count.textContent = visible + ' cụm rạp';
      if (empty) empty.hidden = visible > 0 || cards.length === 0;
    };
    search?.addEventListener('input', filter);
    filter();
  });
</script>
