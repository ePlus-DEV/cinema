---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MomoShowtimeList from '../../components/MomoShowtimeList.astro';
import { cinemas } from '../../lib/cinema-catalog';

interface Props { cinema: (typeof cinemas)[number]; }
export function getStaticPaths() {
  return cinemas.map(cinema => ({
    params: { slug: cinema.chainId + '-' + cinema.apiCinemaId },
    props: { cinema }
  }));
}
const { cinema } = Astro.props;
const description = 'Lịch chiếu trực tiếp, địa chỉ và thông tin cụm rạp ' + cinema.name +
  ' tại TP. Hồ Chí Minh. ePlus Cinema không hỗ trợ mua vé.';
---
<BaseLayout title={cinema.name + ' | ePlus Cinema'} description={description} active="cinemas" canonicalPath={'/rap/' + cinema.chainId + '-' + cinema.apiCinemaId + '/'}>
  <section class="page-hero page-hero--cinema-detail" data-page-priority aria-busy="false">
    <div class="container">
      <nav class="breadcrumbs" aria-label="Đường dẫn trang">
        <a href="/">Trang chủ</a><span>/</span><a href="/rap/">Rạp chiếu</a><span>/</span><span>{cinema.name}</span>
      </nav>
      <div>
        <span class="eyebrow">{cinema.chain || 'HỆ THỐNG RẠP'} · TP. Hồ Chí Minh</span>
        <h1>{cinema.name}</h1>
        <p class="cinema-detail__address">⌖ {cinema.address || 'Chưa có thông tin địa chỉ'}</p>
        <div class="cinema-detail__actions">
          <a class="button button--gold" href="#lich-chieu">Xem suất chiếu ↗</a>
          <a class="button button--outline" href="/rap/">Đổi cụm rạp khác</a>
        </div>
      </div>
    </div>
  </section>
  <section class="section container cinema-detail" id="lich-chieu">
    <div class="section-heading">
      <div><span class="eyebrow">LỊCH CHIẾU TRỰC TIẾP</span><h2>Lịch phim tại {cinema.name}</h2>
      <p>Thông tin rạp có sẵn ngay khi mở trang; giờ chiếu và sơ đồ ghế cập nhật trực tiếp từ API.</p></div>
      <a class="section-link" href="/lich-chieu/">Tất cả rạp <span>↗</span></a>
    </div>
    <div class="schedule-shell">
      <div class="schedule-shell__top"><div><strong>{cinema.name}</strong><span>{cinema.address} · Giờ chiếu lấy trực tiếp từ API</span></div><span class="schedule-shell__city">⌖ TP. Hồ Chí Minh</span></div>
      <MomoShowtimeList cinemaOnly cinemaKey={cinema.chainId + ':' + cinema.apiCinemaId} />
    </div>
  </section>
</BaseLayout>
