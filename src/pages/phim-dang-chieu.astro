---
import BaseLayout from '../layouts/BaseLayout.astro';
import LiveMovieGrid from '../components/LiveMovieGrid.astro';
---
<BaseLayout title="Phim đang chiếu tại TP.HCM | ePlus Cinema" description="Xem danh sách phim đang chiếu, thông tin phim và tra cứu suất chiếu theo rạp tại TP. Hồ Chí Minh trên ePlus Cinema." active="now" canonicalPath="/phim-dang-chieu/" seoIndexable breadcrumbs={[{ name: 'Trang chủ', path: '/' }, { name: 'Phim đang chiếu', path: '/phim-dang-chieu/' }]} />
  <section class="page-hero"><div class="container">
    <div class="breadcrumbs"><a href="/">Trang chủ</a><span>/</span><span>Phim đang chiếu</span></div>
    <span class="eyebrow">ĐANG CÓ GÌ HAY?</span>
    <h1>Phim đang chiếu <span class="title-spark">✳</span></h1>
    <p>Tìm phim yêu thích, xem thông tin chi tiết và chọn lịch chiếu phù hợp.</p>
  </div></section>
  <section class="section container catalog">
    <LiveMovieGrid status="now" limit={100} searchable />
    <p class="catalog__footnote">Dữ liệu phim tham khảo từ MoMo Cinema; ePlus không bán vé.</p>
  </section>
</BaseLayout>
