---
import BaseLayout from '../layouts/BaseLayout.astro';
import LiveMovieGrid from '../components/LiveMovieGrid.astro';
import TrailerModal from '../components/TrailerModal.astro';
import LiveCinemaGrid from '../components/LiveCinemaGrid.astro';
import MomoShowtimeList from '../components/MomoShowtimeList.astro';
---
<BaseLayout active="home" title="ePlus Cinema | Phim đang chiếu, lịch chiếu và rạp tại TP.HCM" description="Khám phá phim đang chiếu, phim sắp chiếu và tra cứu lịch chiếu theo ngày, cụm rạp tại TP. Hồ Chí Minh. ePlus Cinema không bán vé." canonicalPath="/" seoIndexable />
  <section class="section section--featured container" id="phim-dang-chieu">
    <div class="section-heading section-heading--featured">
      <div>
        <span class="eyebrow">CHỌN PHIM CHO BUỔI HẸN</span>
        <h1>Phim đang chiếu <span class="title-spark">✦</span></h1>
        <p>Khám phá phim mới nhất và mở trang chi tiết để tìm suất chiếu phù hợp.</p>
      </div>
      <a class="section-link" href="/phim-dang-chieu">Xem tất cả <span>↗</span></a>
    </div>
    <LiveMovieGrid status="now" limit={12} />
  </section>

  <section class="section section--tinted" id="lich-chieu">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">LÊN KẾ HOẠCH XEM PHIM</span><h2>Khung giờ dành cho bạn</h2><p>Chọn ngày, tìm rạp và xem các khung giờ đang được cung cấp.</p></div>
        <a class="section-link" href="/lich-chieu">Tra cứu đầy đủ <span>↗</span></a>
      </div>
      <div class="schedule-shell">
        <div class="schedule-shell__top"><div><strong>Lịch chiếu tại TP. Hồ Chí Minh</strong><span>Lịch chiếu tham khảo · Bấm giờ để xem sơ đồ ghế</span></div><span class="schedule-shell__city">⌖ TP. Hồ Chí Minh</span></div>
        <MomoShowtimeList />
        <div class="schedule-shell__footer"><a href="/lich-chieu" class="button button--outline">Tra cứu tất cả suất chiếu <span>↗</span></a></div>
      </div>
    </div>
  </section>

  <section class="section container">
    <div class="section-heading">
      <div><span class="eyebrow">DÀNH CHO NGƯỜI MÊ PHIM</span><h2>Sắp ra rạp</h2><p>Thêm vài bộ phim vào danh sách mong chờ.</p></div>
      <a class="section-link" href="/phim-sap-chieu">Khám phá thêm <span>↗</span></a>
    </div>
    <LiveMovieGrid status="soon" limit={6} />
  </section>

  <section class="section section--theaters">
    <div class="container">
      <div class="section-heading">
        <div><span class="eyebrow">THẾ GIỚI RẠP CHIẾU</span><h2>Khám phá cụm rạp</h2><p>Các cụm rạp tại TP. Hồ Chí Minh — dữ liệu cập nhật mỗi ngày.</p></div>
        <a class="section-link" href="/lich-chieu">Xem lịch theo rạp <span>↗</span></a>
      </div>
      <LiveCinemaGrid limit={8} />
    </div>
  </section>

  <TrailerModal />
</BaseLayout>
