---
// Audience-review hub, mirroring the provider's review page: films ordered
// by audience-rating count, each with its featured audience reviews (the
// feed exposes at most 3 per film), paginated with a "Xem thêm" button.
// Data loads live in the browser via src/lib/momo-client.js for the
// visitor's selected city.
import '../styles/movie-extras.css';
---

<div class="review-hub" data-review-hub>
  <div class="review-hub__list" data-hub-list aria-live="polite" aria-busy="true">
    <p class="review-hub__status" data-hub-status>Đang tải đánh giá…</p>
  </div>
  <div class="review-hub__more">
    <button type="button" class="review-hub__button" data-hub-more hidden>Xem thêm đánh giá</button>
  </div>
</div>

<style is:global>
  /* Global on purpose: film blocks are built by script after the API responds. */
  .review-hub__list { display: grid; gap: 18px; }
  .review-hub__film { display: flex; gap: 16px; border: 1px solid #e6eaf0; border-radius: 19px; background: #fff; box-shadow: 0 14px 38px rgba(22,38,59,.035); padding: 16px; }
  .review-hub__poster { flex: none; width: 92px; }
  .review-hub__poster img { width: 92px; aspect-ratio: 2 / 3; object-fit: cover; border-radius: 12px; display: block; background: #eef2f6; }
  .review-hub__main { min-width: 0; flex: 1; }
  .review-hub__main h3 { margin: 0 0 4px; font-size: 1.02rem; }
  .review-hub__main h3 a { color: inherit; text-decoration: none; }
  .review-hub__main h3 a:hover { text-decoration: underline; }
  .review-hub__score { margin: 0 0 6px; color: #b1812f; font-weight: 800; font-size: .86rem; }
  .review-hub__score small { color: var(--muted); font-weight: 600; }
  .review-hub__status { color: var(--muted); padding: 12px 0; }
  .review-hub__status button { margin-left: 10px; border: 1px solid var(--border); background: #fff; border-radius: 999px; padding: 6px 12px; font: inherit; cursor: pointer; color: var(--ink); }
  .review-hub__more { display: flex; justify-content: center; margin-top: 20px; }
  .review-hub__button { border: 1px solid var(--border); background: var(--navy); color: #fff; border-radius: 999px; padding: 11px 22px; font: inherit; font-weight: 700; cursor: pointer; }
  .review-hub__button:disabled { opacity: .55; cursor: wait; }
  @media (max-width: 600px) {
    .review-hub__film { flex-direction: column; }
    .review-hub__poster, .review-hub__poster img { width: 72px; }
  }
</style>

<script>
  import { momoGet, getCityId } from '../lib/momo-client.js';

  const root = document.querySelector('[data-review-hub]');
  if (root) {
    const listEl = root.querySelector('[data-hub-list]');
    const statusEl = root.querySelector('[data-hub-status]');
    const moreBtn = root.querySelector('[data-hub-more]');
    const base = import.meta.env.BASE_URL;
    const vnd = new Intl.NumberFormat('vi-VN');
    let lastIndex = 0;
    let totalItems = Infinity;
    let shown = 0;
    let loading = false;

    const reviewDate = (value) => value ? String(value).slice(0, 10).split('-').reverse().join('/') : '';

    function reviewCard(item) {
      const card = document.createElement('article');
      card.className = 'momo-review';
      if (item.creatorAvatar) {
        const avatar = document.createElement('img');
        avatar.className = 'momo-review__avatar';
        avatar.src = item.creatorAvatar;
        avatar.alt = '';
        avatar.loading = 'lazy';
        card.append(avatar);
      }
      const main = document.createElement('div');
      main.className = 'momo-review__main';
      const head = document.createElement('div');
      head.className = 'momo-review__head';
      const name = document.createElement('strong');
      name.textContent = item.creatorName || 'Khán giả';
      head.append(name);
      if (item.point != null) {
        const point = document.createElement('span');
        point.className = 'momo-review__point';
        point.textContent = '★ ' + item.point + '/10';
        head.append(point);
      }
      if (item.createdTime) {
        const date = document.createElement('span');
        date.className = 'momo-review__date';
        date.textContent = reviewDate(item.createdTime);
        head.append(date);
      }
      main.append(head);
      const tags = Array.isArray(item.tagsV2) ? item.tagsV2.map(t => t?.name).filter(Boolean) : [];
      if (tags.length) {
        const wrap = document.createElement('div');
        wrap.className = 'momo-review__tags';
        for (const tag of tags) {
          const chip = document.createElement('span');
          chip.textContent = tag;
          wrap.append(chip);
        }
        main.append(wrap);
      }
      if (item.desc) {
        const desc = document.createElement('p');
        desc.textContent = item.desc;
        main.append(desc);
      }
      card.append(main);
      return card;
    }

    function filmBlock(film) {
      const block = document.createElement('article');
      block.className = 'review-hub__film';
      const href = base + 'phim/chi-tiet/?id=' + encodeURIComponent(film.Id);
      if (film.GraphicUrl) {
        const posterLink = document.createElement('a');
        posterLink.className = 'review-hub__poster';
        posterLink.href = href;
        const img = document.createElement('img');
        img.src = film.GraphicUrl;
        img.alt = 'Poster phim ' + (film.Title || '');
        img.loading = 'lazy';
        posterLink.append(img);
        block.append(posterLink);
      }
      const main = document.createElement('div');
      main.className = 'review-hub__main';
      const h3 = document.createElement('h3');
      const link = document.createElement('a');
      link.href = href;
      link.textContent = film.Title || '';
      h3.append(link);
      main.append(h3);
      if (film.ApiRatingPoint != null) {
        const score = document.createElement('p');
        score.className = 'review-hub__score';
        score.textContent = '★ ' + String(film.ApiRatingPoint).replace('.', ',') + '/10 ';
        const small = document.createElement('small');
        small.textContent = vnd.format(film.ApiRatingTotal || 0) + ' lượt đánh giá';
        score.append(small);
        main.append(score);
      }
      for (const item of film.TopComments || []) main.append(reviewCard(item));
      block.append(main);
      return block;
    }

    async function loadMore() {
      if (loading || shown >= totalItems) return;
      loading = true;
      moreBtn.disabled = true;
      let emptyPages = 0;
      try {
        while (shown < totalItems && emptyPages < 3) {
          const path = '/cinema/ci-film/loadMore?apiStatus=3&lastIndex=' + encodeURIComponent(lastIndex) +
            '&count=6&sortType=6&sortDir=1&apiCityId=' + getCityId();
          const data = await momoGet(path);
          const items = data.Items || [];
          if (!items.length) { totalItems = shown; break; }
          totalItems = data.TotalItems || shown + items.length;
          lastIndex = data.LastIndex || items[items.length - 1].Id;
          let rendered = 0;
          for (const film of items) {
            if (!Array.isArray(film.TopComments) || !film.TopComments.length) continue;
            listEl.append(filmBlock(film));
            rendered++;
          }
          shown += items.length;
          emptyPages = rendered ? 0 : emptyPages + 1;
          if (rendered) break;
        }
        statusEl.hidden = shown > 0;
        if (!shown) statusEl.textContent = 'Chưa có đánh giá nào cho khu vực này.';
      } catch (error) {
        if (!shown) {
          statusEl.hidden = false;
          statusEl.textContent = 'Không tải được đánh giá (' + error.message + ').';
          const retry = document.createElement('button');
          retry.type = 'button';
          retry.textContent = 'Thử lại';
          retry.addEventListener('click', loadMore);
          statusEl.append(retry);
        }
      } finally {
        loading = false;
        moreBtn.disabled = false;
        moreBtn.hidden = shown >= totalItems;
        listEl.setAttribute('aria-busy', 'false');
      }
    }

    moreBtn.addEventListener('click', loadMore);
    loadMore();
  }
</script>
