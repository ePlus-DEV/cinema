---
interface Props { active?: string; }
const { active = '' } = Astro.props;
const links = [
  { href: '/phim-dang-chieu', label: 'Phim đang chiếu', id: 'now' },
  { href: '/phim-sap-chieu', label: 'Phim sắp chiếu', id: 'soon' },
  { href: '/lich-chieu', label: 'Lịch chiếu', id: 'schedule' },
  { href: '/rap', label: 'Rạp chiếu', id: 'cinemas' },
  { href: '/danh-gia', label: 'Đánh giá', id: 'reviews' }
];
---
<header class="site-header">
  <div class="container site-header__inner">
    <a href="/" class="brand" aria-label="ePlus Cinema - Trang chủ">
      <span class="brand__icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M4 9h16v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9Z" fill="currentColor" opacity=".95"/><path d="M4 5.5 18.2 2l1.3 5.1L4 11V5.5Z" fill="currentColor"/><path d="m8 4.6 2.4 4.5M14.3 3.1l2.4 4.5" stroke="#101827" stroke-width="2"/><path d="m11 12.3 4.7 3.2-4.7 3.1v-6.3Z" fill="#101827"/></svg></span>
      <span>ePlus <strong>Cinema</strong></span>
    </a>
    <nav class="main-nav" id="primary-nav" aria-label="Điều hướng chính">
      {links.map((link) => <a class:list={['main-nav__link', { 'is-active': active === link.id }]} href={link.href}>{link.label}</a>)}
    </nav>
    <div class="site-header__right">
      <a class="location-chip" href="/lich-chieu" title="Khu vực đang xem — đổi thành phố trong mục Lịch chiếu">
        <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 10c0 5-8 11-8 11S4 15 4 10a8 8 0 1 1 16 0Z"/><circle cx="12" cy="10" r="2.5"/></svg>
        <span data-city-name>TP. Hồ Chí Minh</span>
      </a>
      <a class="header-action" href="/lich-chieu"><span class="header-action__label">Lịch chiếu</span><span aria-hidden="true">↗</span></a>
      <button class="menu-toggle" type="button" aria-label="Mở menu" aria-controls="primary-nav" aria-expanded="false" data-menu-toggle>
        <svg width="23" height="23" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h16"/></svg>
      </button>
    </div>
  </div>
  <button type="button" class="menu-backdrop" data-menu-backdrop aria-label="Đóng menu điều hướng" hidden></button>
</header>
<script>
  import { cityDisplayName } from '../lib/cities.js';
  // Reflect the visitor's chosen city (set in the schedule explorer) in the
  // header chip and any other [data-city-name] label on the page.
  try {
    const savedCity = Number(window.localStorage.getItem('eplus-cinema:city'));
    if (savedCity) {
      document.querySelectorAll('[data-city-name]').forEach((el) => {
        el.textContent = cityDisplayName(savedCity);
      });
    }
  } catch { /* storage unavailable */ }
</script>
<script>
  const toggle = document.querySelector<HTMLButtonElement>('[data-menu-toggle]');
  const nav = document.querySelector<HTMLElement>('#primary-nav');
  const backdrop = document.querySelector<HTMLButtonElement>('[data-menu-backdrop]');
  if (toggle && nav) {
    const closeMenu = () => {
      toggle.setAttribute('aria-expanded', 'false');
      toggle.setAttribute('aria-label', 'Mở menu');
      nav.classList.remove('is-open');
      if (backdrop) backdrop.hidden = true;
      document.body.classList.remove('mobile-menu-open');
    };
    toggle.addEventListener('click', () => {
      const opening = toggle.getAttribute('aria-expanded') !== 'true';
      toggle.setAttribute('aria-expanded', String(opening));
      toggle.setAttribute('aria-label', opening ? 'Đóng menu' : 'Mở menu');
      nav.classList.toggle('is-open', opening);
      if (backdrop) backdrop.hidden = !opening;
      document.body.classList.toggle('mobile-menu-open', opening);
    });
    backdrop?.addEventListener('click', closeMenu);
    nav.querySelectorAll('a').forEach((link) => link.addEventListener('click', closeMenu));
    document.addEventListener('keydown', (event) => { if (event.key === 'Escape') closeMenu(); });
    document.addEventListener('click', (event) => {
      if (!nav.contains(event.target as Node) && !toggle.contains(event.target as Node)) closeMenu();
    });
  }
</script>
