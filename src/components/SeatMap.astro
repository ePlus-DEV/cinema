---
import '../styles/seatmap-redesign.css';
// On-site seat map dialog. Opened by dispatching a window event:
//   window.dispatchEvent(new CustomEvent('eplus:open-seats', { detail }))
// where detail = { filmTitle, format, cinemaName, chainName, dateLabel,
//                  timeLabel, show } and `show` is a MoMo ShowTimes entry.
// Seat data comes from POST /v2/cinema/seat via src/lib/momo-client.js.
// Selection is local to this dialog (reference only — no booking/payment).
---

<div class="seatmap" data-seatmap hidden role="dialog" aria-modal="true" aria-label="Sơ đồ ghế">
  <div class="seatmap__backdrop" data-seatmap-close></div>
  <div class="seatmap__panel">
    <header class="seatmap__header">
      <div>
        <span class="seatmap__eyebrow">SƠ ĐỒ GHẾ · XEM TRƯỚC</span>
        <h3 data-seatmap-title>Chọn ghế</h3>
        <p data-seatmap-meta></p>
      </div>
      <button type="button" class="seatmap__close" data-seatmap-close aria-label="Đóng">✕</button>
    </header>
    <div class="seatmap__zoom-controls" data-seatmap-zoom-controls hidden role="group" aria-label="Điều chỉnh độ phóng to sơ đồ ghế">
      <span class="seatmap__zoom-label">Sơ đồ ghế</span>
      <div class="seatmap__zoom-actions">
        <button type="button" data-seatmap-zoom-out aria-label="Thu nhỏ sơ đồ ghế" title="Thu nhỏ">−</button>
        <output data-seatmap-zoom-value aria-live="polite">100%</output>
        <button type="button" data-seatmap-zoom-in aria-label="Phóng to sơ đồ ghế" title="Phóng to">+</button>
        <button type="button" data-seatmap-zoom-fit aria-label="Hiển thị toàn bộ chiều ngang sơ đồ" title="Vừa màn hình">Vừa khung</button>
        <button type="button" data-seatmap-zoom-reset aria-label="Đặt tỷ lệ sơ đồ về 100 phần trăm" title="Đặt lại 100%">100%</button>
      </div>
    </div>
    <div class="seatmap__body" data-seatmap-body aria-live="polite"></div>
    <footer class="seatmap__footer" data-seatmap-footer></footer>
  </div>
</div>

<style is:global>
  /* Global on purpose: the seat grid is injected via innerHTML after the API
     responds, and Astro's scoped styles never reach injected nodes. */
  .seatmap { position: fixed; inset: 0; z-index: 1200; display: grid; place-items: center; }
  .seatmap[hidden] { display: none; }
  .seatmap__backdrop { position: absolute; inset: 0; background: rgba(13, 20, 36, .62); }
  .seatmap__panel {
    position: relative; background: #fff; color: var(--ink); border-radius: 20px;
    width: min(880px, calc(100vw - 24px)); max-height: calc(100vh - 40px);
    display: flex; flex-direction: column; overflow: hidden;
    box-shadow: 0 30px 80px rgba(10, 16, 30, .35);
  }
  .seatmap__header {
    display: flex; justify-content: space-between; gap: 16px; align-items: flex-start;
    padding: 18px 22px 12px; border-bottom: 1px solid var(--border);
  }
  .seatmap__header h3 { margin: 0; font-size: 1.1rem; }
  .seatmap__header p { margin: 4px 0 0; color: var(--muted); font-size: .86rem; }
  .seatmap__close {
    border: 1px solid var(--border); background: #fff; border-radius: 50%;
    width: 34px; height: 34px; cursor: pointer; font: inherit; flex: none;
  }
  .seatmap__body { padding: 16px 22px; overflow: auto; }
  /* Keep the screen and all seat rows inside one intrinsic-width stage.
     The stage is centered when it fits, and the entire map scrolls when it doesn't. */
  .seatmap__map-scroll {
    width: 100%; overflow-x: auto; overscroll-behavior-x: contain;
    padding: 4px 0 10px; scrollbar-width: thin;
  }
  .seatmap__stage { display: flex; flex-direction: column; width: max-content; margin-inline: auto; }
  .seatmap__screen {
    width: 100%; text-align: center; color: var(--muted); font-size: .75rem; letter-spacing: .35em;
    border-top: 4px solid var(--navy); border-radius: 50% 50% 0 0 / 12px 12px 0 0;
    padding-top: 8px; margin: 0 0 18px;
  }
  .seatmap__grid { display: grid; gap: 6px; width: max-content; padding-bottom: 6px; }
  .seatmap__scroll-hint { margin: 0 0 10px; color: var(--muted); font-size: .76rem; text-align: center; }
  @media (max-width: 600px) {
    .seatmap__panel { max-height: calc(100dvh - 24px); }
    .seatmap__body { padding: 12px 14px; }
    .seatmap__header { padding: 15px 14px 12px; }
    .seatmap__footer { padding: 12px 14px; }
  }
  .seatmap__row { display: flex; gap: 5px; align-items: center; }
  .seatmap__row--spacer { height: 18px; }
  .seatmap__row-label { width: 18px; flex: none; text-align: center; color: var(--muted); font-size: .72rem; font-weight: 700; }
  .seat {
    width: 27px; height: 27px; flex: none; border-radius: 8px 8px 3px 3px;
    border: 1.5px solid #b9c2d0; background: #fff; color: #42506a;
    font-size: .62rem; font-weight: 700; cursor: pointer; padding: 0;
    display: grid; place-items: center;
  }
  .seat:hover:not(:disabled) { border-color: var(--navy); }
  .seat--gap { visibility: hidden; }
  .seat:disabled { background: #e3e7ee; border-color: #d3d9e2; color: #9aa5b5; cursor: not-allowed; text-decoration: line-through; }
  .seat[aria-pressed="true"] { background: var(--navy); border-color: var(--navy); color: #fff; }
  .seatmap__legend { display: flex; flex-wrap: wrap; justify-content: center; gap: 10px 14px; margin-top: 14px; color: var(--muted); font-size: .8rem; }
  .seatmap__legend span { display: inline-flex; gap: 6px; align-items: center; }
  .seatmap__swatch { width: 16px; height: 16px; border-radius: 5px 5px 2px 2px; border: 1.5px solid #b9c2d0; background: #fff; display: inline-block; }
  .seatmap__swatch--taken { background: #e3e7ee; border-color: #d3d9e2; }
  .seatmap__swatch--selected { background: var(--navy); border-color: var(--navy); }
  .seatmap__footer {
    border-top: 1px solid var(--border); padding: 13px 22px; display: flex;
    flex-wrap: wrap; gap: 8px 18px; align-items: center; justify-content: space-between;
    background: var(--warm); font-size: .9rem;
  }
  .seatmap__footer:empty { display: none; }
  .seatmap__total strong { font-size: 1.02rem; }
  .seatmap__note { color: var(--muted); font-size: .78rem; flex-basis: 100%; }
  .seatmap__seats-placeholder { display: grid; gap: 8px; padding: 14px 0 20px; }
  .seatmap__seats-placeholder-screen { height: 12px; width: min(75%, 430px); margin: 0 auto 16px; border-radius: 100% 100% 4px 4px; background: #dce3ed; }
  .seatmap__seats-placeholder-row { display: flex; gap: 7px; justify-content: center; overflow: hidden; }
  .seatmap__seats-placeholder-seat { width: 25px; height: 25px; flex: none; border-radius: 7px 7px 3px 3px; background: #e4eaf2; }
  .seatmap__status { color: var(--muted); padding: 10px 0 16px; }
  .seatmap__status button {
    margin-left: 10px; border: 1px solid var(--border); background: #fff; border-radius: 999px;
    padding: 6px 12px; font: inherit; cursor: pointer; color: var(--ink);
  }
</style>

<script>
  import { loadSeats } from '../lib/momo-client.js';
  import { seatTypePalette, seatColorStyle } from '../lib/seat-colors.js';
  import { estimateCenterZone } from '../lib/seat-center-zone.js';

  const root = document.querySelector('[data-seatmap]');
  if (root) {
    // Escape parent stacking contexts so the fixed dialog is never covered
    // by the sticky site header or clipped inside a schedule card on iOS.
    if (root.parentElement !== document.body) document.body.append(root);
    const titleEl = root.querySelector('[data-seatmap-title]');
    const metaEl = root.querySelector('[data-seatmap-meta]');
    const bodyEl = root.querySelector('[data-seatmap-body]');
    const footerEl = root.querySelector('[data-seatmap-footer]');
    const zoomControls = root.querySelector('[data-seatmap-zoom-controls]');
    const zoomValueEl = root.querySelector('[data-seatmap-zoom-value]');
    const zoomOutBtn = root.querySelector('[data-seatmap-zoom-out]');
    const zoomInBtn = root.querySelector('[data-seatmap-zoom-in]');
    const zoomFitBtn = root.querySelector('[data-seatmap-zoom-fit]');
    const zoomResetBtn = root.querySelector('[data-seatmap-zoom-reset]');
    const ZOOM_MIN = 0.45;
    const ZOOM_MAX = 1.8;
    const ZOOM_STEP = 0.15;
    let zoom = 1;
    let naturalStageWidth = 0;
    let pinchStartDistance = 0;
    let pinchStartZoom = 1;
    const vnd = new Intl.NumberFormat('vi-VN');
    const selected = new Map();
    let requestToken = 0;

    const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (ch) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]
    ));

    function close() {
      ++requestToken; // Ignore a late seat response after the dialog closes.
      root.hidden = true;
      document.body.style.overflow = '';
      zoomControls.hidden = true;
    }
    root.querySelectorAll('[data-seatmap-close]').forEach((el) => el.addEventListener('click', close));
    window.addEventListener('keydown', (event) => { if (event.key === 'Escape' && !root.hidden) close(); });

    function renderFooter() {
      const seats = [...selected.values()];
      if (!seats.length) {
        footerEl.innerHTML = '<span>Chưa chọn ghế nào — bấm vào ghế trống để chọn.</span>' +
          '<span class="seatmap__note">Trạng thái ghế tại thời điểm tải. ePlus hiện chưa hỗ trợ giữ ghế và thanh toán trực tuyến.</span>';
        return;
      }
      const total = seats.reduce((sum, seat) => sum + (seat.price || 0), 0);
      const labels = seats.map((seat) => seat.label).join(', ');
      footerEl.innerHTML = `<span class="seatmap__total">Đã chọn <strong>${seats.length} ghế</strong>: ${esc(labels)}</span>` +
        `<span class="seatmap__total">Tổng: <strong>${vnd.format(total)}₫</strong></span>` +
        '<span class="seatmap__note">Trạng thái ghế tại thời điểm tải. ePlus hiện chưa hỗ trợ giữ ghế và thanh toán trực tuyến.</span>';
    }

    function limitZoom(value) {
      return Math.min(ZOOM_MAX, Math.max(ZOOM_MIN, Math.round(value * 100) / 100));
    }

    function applyZoom(value, { center = true } = {}) {
      const scroller = bodyEl.querySelector('[data-seatmap-scroll]');
      const stage = bodyEl.querySelector('[data-seatmap-stage]');
      if (!scroller || !stage) return;
      const next = limitZoom(value);
      const previous = zoom;
      if (Math.abs(next - previous) < 0.001) return;
      const centerX = scroller.scrollLeft + scroller.clientWidth / 2;
      const centerY = scroller.scrollTop + scroller.clientHeight / 2;
      stage.style.zoom = String(next);
      zoom = next;
      zoomValueEl.textContent = Math.round(zoom * 100) + '%';
      zoomOutBtn.disabled = zoom <= ZOOM_MIN;
      zoomInBtn.disabled = zoom >= ZOOM_MAX;
      requestAnimationFrame(() => {
        if (center) {
          scroller.scrollLeft = centerX * (next / previous) - scroller.clientWidth / 2;
          scroller.scrollTop = centerY * (next / previous) - scroller.clientHeight / 2;
        } else {
          scroller.scrollLeft = Math.max(0, (scroller.scrollWidth - scroller.clientWidth) / 2);
          scroller.scrollTop = 0;
        }
        const hint = bodyEl.querySelector('[data-seatmap-hint]');
        if (hint) hint.hidden = scroller.scrollWidth <= scroller.clientWidth + 1;
      });
    }

    function zoomToFit() {
      const scroller = bodyEl.querySelector('[data-seatmap-scroll]');
      if (!scroller || !naturalStageWidth) return;
      applyZoom((scroller.clientWidth - 10) / naturalStageWidth, { center: false });
    }

    function drawCenterRegion() {
      const grid = bodyEl.querySelector('[data-seatmap-grid]');
      if (!grid) return false;
      grid.querySelector('[data-seatmap-center-zone]')?.remove();
      // Use the seat positions that are actually rendered, not raw row
      // indices: detached banks after an aisle must not stretch the box.
      const seatRows = [...grid.querySelectorAll('.seatmap__row')].map(row => ({
        seats: [...row.querySelectorAll('.seat:not(.seat--gap)')].map(seat => ({
          x: seat.offsetLeft,
          y: seat.offsetTop,
          width: seat.offsetWidth,
          height: seat.offsetHeight
        }))
      }));
      const zone = estimateCenterZone(seatRows);
      if (!zone) return false;
      const frame = document.createElement('div');
      frame.className = 'seatmap__center-zone';
      frame.dataset.seatmapCenterZone = '';
      frame.setAttribute('aria-hidden', 'true');
      frame.title = 'Ước lượng khu vực giữa dãy ghế chính, không bao gồm lối đi.';
      Object.assign(frame.style, {
        left: zone.x + 'px', top: zone.y + 'px',
        width: zone.width + 'px', height: zone.height + 'px'
      });
      grid.append(frame);
      return true;
    }

    zoomOutBtn.addEventListener('click', () => applyZoom(zoom - ZOOM_STEP));
    zoomInBtn.addEventListener('click', () => applyZoom(zoom + ZOOM_STEP));
    zoomFitBtn.addEventListener('click', zoomToFit);
    zoomResetBtn.addEventListener('click', () => applyZoom(1));

    function renderSeats(detail, data) {
      const info = data.SeatsInfo;
      const palette = seatTypePalette(info.SeatTypes || []);
      const visibleTypes = new Set();
      let unknownType = false;
      let free = 0;
      let taken = 0;
      // MoMo's grid can contain fully-empty rows (no seat cells at all —
      // e.g. 10 blank rows between row H and the Sweetbox row S at CGV Aeon
      // Bình Tân, where a walkway separates the back bank). Rendering them
      // all opens a phantom void in the map, but dropping them entirely
      // would glue the detached back bank onto the main block. Collapse any
      // run of empty rows into ONE slim walkway spacer: the map stays
      // compact and the physical separation (which the center-zone estimate
      // relies on) is preserved. Leading/trailing empty rows are dropped.
      const renderRows = [];
      let pendingSpacer = false;
      for (const row of info.Seats || []) {
        if (row.some((seat) => seat.id)) {
          if (pendingSpacer && renderRows.length) renderRows.push(null);
          renderRows.push(row);
          pendingSpacer = false;
        } else if (renderRows.length) pendingSpacer = true;
      }
      const rowsHtml = renderRows.map((row) => {
        if (!row) return '<div class="seatmap__row seatmap__row--spacer" aria-hidden="true"></div>';
        const label = row.find((seat) => seat.nameRow)?.nameRow || '';
        const cells = row.map((seat) => {
          if (!seat.id) return '<span class="seat seat--gap" aria-hidden="true"></span>';
          const name = `${seat.nameRow}${seat.momoId || ''}`;
          const type = palette.get(String(seat.cinemaAreaCode));
          if (seat.status !== 0) {
            taken++;
            return `<button type="button" class="seat" disabled title="${esc(name)} — đã đặt">${esc(seat.momoId || '')}</button>`;
          }
          free++;
          if (type) visibleTypes.add(type.key);
          else unknownType = true;
          const seatTypeName = type?.label || 'Chưa xác định loại ghế';
          const style = type ? seatColorStyle(type)
            : '--seat-type-color:#637186;--seat-type-foreground:#ffffff';
          const tooltip = name + ' · ' + seatTypeName + ' — ' + vnd.format(seat.price || 0) + '₫';
          return `<button type="button" class="seat seat--available" style="${style}" data-seat="${esc(name)}" data-price="${seat.price || 0}" aria-label="${esc(tooltip)}" aria-pressed="false" title="${esc(tooltip)}">${esc(seat.momoId || '')}</button>`;
        }).join('');
        return `<div class="seatmap__row"><span class="seatmap__row-label">${esc(label)}</span>${cells}<span class="seatmap__row-label">${esc(label)}</span></div>`;
      }).join('');
      const legendTypes = [...visibleTypes].map((key) => {
        const type = palette.get(key);
        return `<span><i class="seatmap__swatch seatmap__swatch--type" style="${seatColorStyle(type)}"></i>${esc(type.label)}</span>`;
      }).join('');
      const unknownLegend = unknownType
        ? '<span><i class="seatmap__swatch seatmap__swatch--unknown"></i>Chưa rõ loại ghế</span>'
        : '';
      bodyEl.innerHTML = `<div class="seatmap__map-scroll" data-seatmap-scroll role="region" aria-label="Sơ đồ ghế — cuộn ngang hoặc dùng điều khiển phóng to thu nhỏ để xem tất cả các ghế" tabindex="0">
          <div class="seatmap__stage" data-seatmap-stage>
            <div class="seatmap__screen">MÀN HÌNH</div>
            <div class="seatmap__grid" data-seatmap-grid>${rowsHtml}</div>
          </div>
        </div>
        <p class="seatmap__scroll-hint" data-seatmap-hint hidden>↔ Vuốt ngang để xem toàn bộ ghế</p>
        <div class="seatmap__counts" aria-label="Thống kê trạng thái ghế">
          <span>Còn trống <strong>${free}</strong></span>
          <span>Đã đặt <strong>${taken}</strong></span>
        </div>
        <div class="seatmap__legend" aria-label="Chú thích màu ghế">
          ${legendTypes}
          ${unknownLegend}
          <span><i class="seatmap__swatch seatmap__swatch--taken"></i>Đã đặt</span>
          <span><i class="seatmap__swatch seatmap__swatch--selected"></i>Đang chọn</span>
          <span data-seatmap-center-legend><i class="seatmap__swatch seatmap__swatch--center"></i>Giữa dãy ghế chính (ước lượng)</span>
        </div>`;
      zoom = 1;
      zoomControls.hidden = false;
      zoomValueEl.textContent = '100%';
      zoomOutBtn.disabled = false;
      zoomInBtn.disabled = false;
      const hasCenterZone = drawCenterRegion();
      const centerLegend = bodyEl.querySelector('[data-seatmap-center-legend]');
      if (centerLegend) centerLegend.hidden = !hasCenterZone;
      const scroller = bodyEl.querySelector('[data-seatmap-scroll]');
      const stage = bodyEl.querySelector('[data-seatmap-stage]');
      naturalStageWidth = stage?.offsetWidth || 0;
      const hint = bodyEl.querySelector('[data-seatmap-hint]');
      if (scroller) {
        const horizontalOverflow = scroller.scrollWidth > scroller.clientWidth + 1;
        if (hint) hint.hidden = !horizontalOverflow;
        // Start at the middle on narrow screens without changing seat positions.
        if (horizontalOverflow) scroller.scrollLeft = (scroller.scrollWidth - scroller.clientWidth) / 2;
      }
      // Two-finger pinch controls the same geometry as the zoom buttons.
      // One-finger swipes continue to pan through the auditorium.
      scroller?.addEventListener('touchstart', (event) => {
        if (event.touches.length !== 2) return;
        pinchStartDistance = Math.hypot(event.touches[0].clientX - event.touches[1].clientX,
          event.touches[0].clientY - event.touches[1].clientY);
        pinchStartZoom = zoom;
      }, { passive: true });
      scroller?.addEventListener('touchmove', (event) => {
        if (event.touches.length !== 2 || !pinchStartDistance) return;
        event.preventDefault();
        const distance = Math.hypot(event.touches[0].clientX - event.touches[1].clientX,
          event.touches[0].clientY - event.touches[1].clientY);
        applyZoom(pinchStartZoom * distance / pinchStartDistance);
      }, { passive: false });
      scroller?.addEventListener('touchend', (event) => {
        if (event.touches.length < 2) pinchStartDistance = 0;
      }, { passive: true });
      bodyEl.querySelectorAll('[data-seat]').forEach((button) => {
        button.addEventListener('click', () => {
          const name = button.dataset.seat;
          if (selected.has(name)) {
            selected.delete(name);
            button.classList.remove('seat--selected');
            button.setAttribute('aria-pressed', 'false');
          } else {
            selected.set(name, { label: name, price: Number(button.dataset.price || 0) });
            button.classList.add('seat--selected');
            button.setAttribute('aria-pressed', 'true');
          }
          renderFooter();
        });
      });
      renderFooter();
    }

    async function open(detail) {
      const token = ++requestToken;
      selected.clear();
      zoomControls.hidden = true;
      zoom = 1;
      naturalStageWidth = 0;
      pinchStartDistance = 0;
      footerEl.innerHTML = '';
      titleEl.textContent = detail.filmTitle || 'Chọn ghế';
      metaEl.textContent = [detail.cinemaName, detail.screenName, detail.dateLabel, detail.timeLabel, detail.format]
        .filter(Boolean).join(' · ');
      bodyEl.innerHTML = `<div class="seatmap__seats-placeholder" aria-hidden="true">
          <div class="seatmap__seats-placeholder-screen skeleton"></div>
          ${Array.from({ length: 7 }, () => `<div class="seatmap__seats-placeholder-row">
            ${Array.from({ length: 12 }, () => '<span class="seatmap__seats-placeholder-seat skeleton"></span>').join('')}
          </div>`).join('')}
        </div><p class="seatmap__status">Đang tải sơ đồ ghế…</p>`;
      root.hidden = false;
      document.body.style.overflow = 'hidden';
      try {
        const data = await loadSeats(detail.show);
        if (token !== requestToken || root.hidden) return;
        renderSeats(detail, data);
      } catch (error) {
        if (token !== requestToken) return;
        bodyEl.innerHTML = '';
        const p = document.createElement('p');
        p.className = 'seatmap__status';
        p.textContent = `Không tải được sơ đồ ghế (${error.message}).`;
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = 'Thử lại';
        button.addEventListener('click', () => open(detail));
        p.append(button);
        bodyEl.append(p);
      }
    }

    window.addEventListener('eplus:open-seats', (event) => open(event.detail || {}));
  }
</script>
