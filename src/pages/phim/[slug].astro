---
import BaseLayout from '../../layouts/BaseLayout.astro';
import MomoShowtimeList from '../../components/MomoShowtimeList.astro';
import MovieExtras from '../../components/MovieExtras.astro';
import { movies } from '../../lib/cinema-catalog';

interface Props { movie: (typeof movies)[number]; }
export function getStaticPaths() {
  return movies.map(movie => ({ params: { slug: movie.id }, props: { movie } }));
}
const { movie } = Astro.props;
const showNow = movie.status === 'now';
const description = movie.synopsis
  ? movie.synopsis.slice(0, 155)
  : 'Thông tin phim ' + movie.title + (showNow ? ' và lịch chiếu tại TP. Hồ Chí Minh.' : ' sắp ra rạp tại TP. Hồ Chí Minh.');
---
<BaseLayout title={movie.title + ' | ePlus Cinema'} description={description} active={showNow ? 'now' : 'soon'} canonicalPath={'/phim/' + movie.id + '/'}>
  <section class="live-detail live-film-detail" data-page-priority aria-busy="false">
    <div class="container">
      <nav class="breadcrumbs breadcrumbs--light" aria-label="Đường dẫn trang">
        <a href="/">Trang chủ</a><span>/</span>
        <a href={showNow ? '/phim-dang-chieu/' : '/phim-sap-chieu/'}>{showNow ? 'Đang chiếu' : 'Sắp chiếu'}</a>
        <span>/</span><span>{movie.title}</span>
      </nav>
      <div class="live-detail__grid">
        <div class="live-detail__poster">
          {movie.posterUrl ? <img src={movie.posterUrl} alt={'Poster phim ' + movie.title} decoding="async" fetchpriority="high" /> : <span>Chưa có poster</span>}
        </div>
        <div class="live-detail__info">
          <span class="live-detail__badge">{showNow ? 'Đang chiếu' : 'Sắp chiếu'}</span>
          <h1>{movie.title}</h1>
          {movie.titleEn && movie.titleEn !== movie.title && <p class="live-detail__original">{movie.titleEn}</p>}
          <div class="live-detail__tags">
            {movie.age && <span>{movie.age}</span>}
            {movie.genre && <span>{movie.genre}</span>}
            {movie.duration > 0 && <span>{movie.duration} phút</span>}
            {movie.openingDate && <span>Khởi chiếu: {movie.openingDate}</span>}
          </div>
          <h2>Giới thiệu phim</h2>
          <p class="live-detail__synopsis">{movie.synopsis || 'Nguồn dữ liệu chưa cung cấp nội dung giới thiệu phim.'}</p>
          <div class="live-detail__actions">
            {showNow && <a class="button button--gold" href="#lich-chieu">Xem lịch chiếu <span aria-hidden="true">↗</span></a>}
            <a class="button button--glass" href="#trailer">Trailer &amp; review ↘</a>
            <a class="button button--glass" href={showNow ? '/phim-dang-chieu/' : '/phim-sap-chieu/'}>Khám phá phim khác</a>
          </div>
          <p class="live-detail__source">Thông tin phim từ bản cập nhật hằng ngày · Lịch chiếu và sơ đồ ghế chỉ mang tính tham khảo.</p>
        </div>
      </div>
    </div>
  </section>
  <MovieExtras movie={movie} />
  {showNow ? <section class="section container" id="lich-chieu">
    <div class="section-heading">
      <div><span class="eyebrow">LỊCH CHIẾU TRỰC TIẾP</span><h2>Suất chiếu: {movie.title}</h2>
        <p>Phần thông tin phim đã được tải sẵn. Chọn ngày và rạp để cập nhật giờ chiếu trực tiếp.</p></div>
      <a class="section-link" href="/lich-chieu/">Xem tất cả <span>↗</span></a>
    </div>
    <div class="schedule-shell">
      <div class="schedule-shell__top"><div><strong>{movie.title}</strong><span>Lịch chiếu lấy trực tiếp từ API · Không đặt vé</span></div><span class="schedule-shell__city">⌖ TP. Hồ Chí Minh</span></div>
      <MomoShowtimeList movieId={movie.id} />
    </div>
  </section> : <section class="section container">
    <div class="message-panel"><span>✦</span><div><h2>Phim sắp khởi chiếu</h2><p>Thông tin ngày chiếu có thể thay đổi. Xem lại danh sách phim để cập nhật sau.</p></div></div>
  </section>}
</BaseLayout>
