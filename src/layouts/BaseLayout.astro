---
import '../styles/global.css';
import '../styles/cinema-refresh.css';
import SiteHeader from '../components/SiteHeader.astro';
import PageSkeleton from '../components/PageSkeleton.astro';
import SeoHead from '../components/SeoHead.astro';

interface Props {
  title?: string;
  description?: string;
  active?: string;
  canonicalPath?: string | null;
  seoIndexable?: boolean;
  breadcrumbs?: { name: string; path: string }[];
}
const {
  title = 'ePlus Cinema — Tìm phim, chọn giờ chiếu',
  description = 'Giao diện thử nghiệm tra cứu phim và suất chiếu tại Việt Nam.',
  active = '',
  canonicalPath,
  seoIndexable = false,
  breadcrumbs = []
} = Astro.props;
const isPrPreview = /\/previews\/pr-\d+\//.test(import.meta.env.BASE_URL || '/');
---
<!doctype html>
<html lang="vi">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101827" />
    <SeoHead title={title} description={description} canonicalPath={canonicalPath} seoIndexable={seoIndexable} breadcrumbs={breadcrumbs} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Be+Vietnam+Pro:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
    <title>{title}</title>
    <script is:inline>
      document.documentElement.classList.add('has-js');
      // Fail-safe if a bundled script is blocked or a provider never responds.
      window.setTimeout(() => document.documentElement.classList.add('page-skeleton-done'), 5000);
    </script>
  </head>
  <body class="cinema-ui">
    <a class="skip-link" href="#main-content">Bỏ qua điều hướng</a>
    {isPrPreview && <div class="preview-banner" role="note">
      <span class="preview-banner__dot"></span>
      Bản xem trước của ePlus Cinema · Thông tin phim/rạp tải từ bản cập nhật hằng ngày; lịch chiếu được tra cứu trực tiếp.
    </div>}
    <SiteHeader active={active} />
    {/* The homepage hero and movie rails are already server-rendered from the
        daily catalog. Never cover them with a page-wide loading overlay;
        only live showtimes keep their own local skeletons. */}
    {active !== 'home' && <PageSkeleton active={active} />}
    <main id="main-content"><slot /></main>
    <footer class="footer">
      <div class="container footer__inner">
        <div>
          <a href="/" class="footer__brand" aria-label="ePlus Cinema - Trang chủ"><span class="brand__icon" aria-hidden="true"><svg width="24" height="24" viewBox="0 0 24 24" fill="none"><path d="M4 9h16v10a2 2 0 0 1-2 2H6a2 2 0 0 1-2-2V9Z" fill="currentColor" opacity=".95"/><path d="M4 5.5 18.2 2l1.3 5.1L4 11V5.5Z" fill="currentColor"/><path d="m8 4.6 2.4 4.5M14.3 3.1l2.4 4.5" stroke="#101827" stroke-width="2"/><path d="m11 12.3 4.7 3.2-4.7 3.1v-6.3Z" fill="#101827"/></svg></span> ePlus <strong>Cinema</strong></a>
          <p>Khám phá phim và tìm lịch chiếu theo cách đơn giản hơn.</p>
          <span class="footer__notice">Dữ liệu tham khảo · Không hỗ trợ đặt vé</span>
        </div>
        <div class="footer__links">
          <div><strong>Khám phá</strong><a href="/phim-dang-chieu">Phim đang chiếu</a><a href="/phim-sap-chieu">Phim sắp chiếu</a></div>
          <div><strong>Tra cứu</strong><a href="/lich-chieu">Lịch chiếu</a><a href="/rap">Hệ thống rạp</a></div>
          <div><strong>ePlus</strong><a href="https://eplus.dev/" target="_blank" rel="noopener noreferrer">ePlus DEV ↗</a><a href="https://github.com/ePlus-DEV/cinema" target="_blank" rel="noopener noreferrer">GitHub ↗</a></div>
        </div>
      </div>
      <div class="container footer__bottom"><span>© {new Date().getFullYear()} ePlus Cinema.</span><span>Made for movie lovers ✦</span></div>
    </footer>
  </body>
</html>
