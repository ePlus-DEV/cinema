---
// Live MoMo showtimes: all data is fetched in the visitor's browser from the
// MoMo Cinema API (through the CORS proxy configured by PUBLIC_MOMO_CORS_PROXY,
// see src/lib/momo-client.js). Nothing is rendered server-side. Clicking a
// showtime opens the on-site seat map (SeatMap) — no link leaves ePlus.
import SeatMap from './SeatMap.astro';
import DatePicker from './DatePicker.astro';
import '../styles/cinema-explorer.css';
import { movies, cinemas } from '../lib/cinema-catalog';
interface Props { cinemaOnly?: boolean; movieId?: string; cinemaKey?: string; }
const { cinemaOnly = false, movieId = '', cinemaKey = '' } = Astro.props;
const knownMovieIds = movies.map(movie => movie.id).join(',');
const knownCinemaKeys = cinemas.map(cinema => cinema.chainId + ':' + cinema.apiCinemaId).join(',');
---

<div class="momo-live" data-momo-live data-cinema-only={cinemaOnly ? "true" : "false"} data-movie-id={movieId} data-cinema-key={cinemaKey} data-known-movies={knownMovieIds} data-known-cinemas={knownCinemaKeys}>
  <div class="momo-live__location">
    <div class="momo-live__place"><span aria-hidden="true">⌖</span><div><small>Thành phố đang xem</small><strong data-momo-city-name>TP. Hồ Chí Minh</strong></div></div>
    <label class="momo-live__district-label">Thành phố
      <select data-momo-city aria-label="Chọn thành phố">
        <option value="50">TP. Hồ Chí Minh</option>
      </select>
    </label>
    <label class="momo-live__district-label" for="cinema-district">Khu vực
      <select id="cinema-district" data-momo-district aria-label="Lọc rạp theo quận hoặc khu vực">
        <option value="">Tất cả khu vực</option>
      </select>
    </label>
    <span class="momo-live__location-note" data-momo-city-note>Chỉ hiển thị rạp tại TP. Hồ Chí Minh</span>
  </div>
  <div class="momo-live__toolbar">
    <div class="momo-live__chips" data-momo-chips role="group" aria-label="Lọc hệ thống rạp">
      {[0,1,2,3].map(() => <span class="momo-live__chip-placeholder skeleton" aria-hidden="true"></span>)}
    </div>
  </div>
  <div class="momo-live__layout">
    <aside class="momo-live__cinema-pane">
      <label class="momo-live__search-wrap">
        <span class="sr-only">Tìm rạp theo tên hoặc địa chỉ</span>
        <input class="momo-live__search" type="search" placeholder="Tìm tên rạp hoặc địa chỉ…" aria-label="Tìm rạp" data-momo-search />
        <span aria-hidden="true">⌕</span>
      </label>
      <div class="momo-live__cinemas" data-momo-cinemas aria-label="Danh sách rạp" aria-busy="true">
        {Array.from({ length: 5 }).map(() => <div class="momo-live__cinema-placeholder skeleton" aria-hidden="true">
          <span class="skeleton__line" style="width:73%"></span>
          <span class="skeleton__line skeleton__line--short"></span>
        </div>)}
      </div>
    </aside>
    <div class="momo-live__viewer">
      <div class="momo-live__viewer-head"><span data-momo-selected-cinema>Chọn rạp để xem lịch chiếu</span><small data-momo-selected-address></small></div>
      <div class="momo-live__datebar"><DatePicker /></div>
      <div class="momo-live__results" data-momo-results aria-live="polite" aria-busy="true">
      <div class="momo-live__loading-head skeleton" aria-hidden="true"><span class="skeleton__line" style="width:54%"></span><span class="skeleton__line skeleton__line--short"></span></div>
      <div class="momo-live__loading-programs" aria-hidden="true">
        {[0,1].map(() => <div class="momo-live__loading-program skeleton">
          <span class="momo-live__loading-poster"></span>
          <div class="momo-live__loading-content">
            <span class="skeleton__line" style="width:75%"></span>
            <span class="skeleton__line skeleton__line--short"></span>
            <div class="momo-live__loading-times">{[0,1,2,3].map(() => <span class="momo-live__loading-time"></span>)}</div>
          </div>
        </div>)}
      </div>
      <p class="momo-live__status">Đang tải dữ liệu suất chiếu…</p>
      </div>
    </div>
  </div>
</div>
<SeatMap />

<style is:global>
  /* Global on purpose: most of this UI is injected via innerHTML after the
     API responds, and Astro's scoped styles never reach injected nodes. */
  .momo-live__toolbar { display: flex; flex-wrap: wrap; gap: 12px; align-items: center; margin-bottom: 16px; }
  .momo-live__chip-placeholder { width: 82px; height: 35px; border-radius: 10px; background: #eef1f6; }
  .momo-live__cinema-placeholder { border-radius: 12px; min-height: 74px; border: 1px solid #e9edf3; background: #f4f6f9; padding: 16px 14px; }
  .momo-live__cinema-placeholder .skeleton__line { margin-top: 0; height: 11px; }
  .momo-live__cinema-placeholder .skeleton__line + .skeleton__line { margin-top: 11px; }
  .momo-live__loading-head { padding: 15px 0 21px; border-bottom: 1px solid #edf0f4; }
  .momo-live__loading-programs { display: grid; gap: 12px; padding-top: 15px; }
  .momo-live__loading-program { display: flex; align-items: flex-start; gap: 14px; border: 1px solid #e8edf3; background: #fbfcfe; border-radius: 14px; padding: 17px; }
  .momo-live__loading-poster { flex: 0 0 57px; height: 80px; border-radius: 9px; background: #e1e7ef; }
  .momo-live__loading-content { flex: 1; min-width: 0; }
  .momo-live__loading-content > .skeleton__line { margin: 0 0 11px; }
  .momo-live__loading-times { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 13px; }
  .momo-live__loading-time { width: 58px; height: 34px; background: #e3e9f1; border-radius: 8px; }
  @media (max-width: 600px) { .momo-live__loading-program { padding: 12px; gap: 10px; } .momo-live__loading-poster { flex-basis: 46px; height: 68px; } .momo-live__loading-time { width: 54px; } }
  .momo-live__search {
    flex: 1 1 220px; padding: 10px 14px; border: 1px solid var(--border);
    border-radius: 999px; font: inherit; background: #fff; color: var(--ink);
  }
  .momo-live__chips { display: flex; flex-wrap: wrap; gap: 8px; }
  .momo-live__chip {
    border: 1px solid var(--border); background: #fff; color: var(--ink);
    border-radius: 999px; padding: 7px 13px; font: inherit; font-size: 0.86rem; cursor: pointer;
  }
  .momo-live__chip[aria-pressed="true"] { background: var(--navy); color: #fff; border-color: var(--navy); }
  .momo-live__layout { display: grid; grid-template-columns: minmax(230px, 300px) 1fr; gap: 20px; align-items: start; }
  @media (max-width: 760px) { .momo-live__layout { grid-template-columns: 1fr; } }
  .momo-live__cinemas { display: flex; flex-direction: column; gap: 8px; max-height: 640px; overflow: auto; }
  .momo-live__cinema {
    text-align: left; border: 1px solid var(--border); background: #fff; border-radius: 14px;
    padding: 10px 13px; font: inherit; cursor: pointer; color: var(--ink);
  }
  .momo-live__cinema strong { display: block; font-size: 0.95rem; }
  .momo-live__cinema span { display: block; color: var(--muted); font-size: 0.8rem; margin-top: 2px; }
  .momo-live__cinema[aria-current="true"] { border-color: var(--navy); background: var(--warm); }
  .momo-live__status { color: var(--muted); padding: 18px 4px; }
  .momo-live__status button {
    margin-left: 10px; border: 1px solid var(--border); background: #fff; border-radius: 999px;
    padding: 6px 12px; font: inherit; cursor: pointer; color: var(--ink);
  }
  .momo-live__program-head { display: flex; gap: 14px; align-items: flex-start; }
  .theater-showtime__header { display: flex; justify-content: space-between; gap: 16px; align-items: flex-start; margin-bottom: 6px; }
  .theater-showtime__header h3 { margin: 2px 0 4px; font-size: 1.05rem; }
  .theater-showtime__header p { margin: 0; color: var(--muted); font-size: .85rem; }
  .date-label { flex: none; background: var(--soft); border: 1px solid var(--border); border-radius: 999px; padding: 6px 12px; font-size: .82rem; font-weight: 700; }
  .program__format { display: flex; gap: 14px; align-items: flex-start; margin-top: 10px; flex-wrap: wrap; }
  .program__format-label { flex: none; min-width: 92px; color: var(--muted); font-size: .82rem; font-weight: 700; padding-top: 8px; }
  .showtime-row { display: flex; flex-wrap: wrap; gap: 8px; }
  .showtime {
    border: 1px solid #e2e5eb; background: #fff; border-radius: 8px; color: #343e51;
    padding: 8px 12px; font: inherit; font-size: .85rem; font-weight: 800; cursor: pointer;
    min-width: 58px; text-align: center; transition: background .2s, border-color .2s;
  }
  .showtime:hover { background: #fff3d5; border-color: #edca78; }
  .momo-live__poster { width: 54px; height: 76px; object-fit: cover; border-radius: 8px; flex: none; background: var(--soft); }
</style>

<script>
  import { CHAINS, formatLabel, loadAllCinemas, momoPost, saigonDate, getCityId, setCityId } from '../lib/momo-client.js';
  import { CITIES, cityDisplayName } from '../lib/cities.js';
  import { createChainLogo } from '../lib/cinema-logos.js';

  import { moviePath, cinemaPath } from '../lib/cinema-routes.js';
  const root = document.querySelector('[data-momo-live]');
  if (root) {
    const chipsEl = root.querySelector('[data-momo-chips]');
    const cinemasEl = root.querySelector('[data-momo-cinemas]');
    const resultsEl = root.querySelector('[data-momo-results]');
    const searchEl = root.querySelector('[data-momo-search]');
    const districtEl = root.querySelector('[data-momo-district]');
    const cityEl = root.querySelector('[data-momo-city]');
    const cityNameEl = root.querySelector('[data-momo-city-name]');
    const cityNoteEl = root.querySelector('[data-momo-city-note]');
    const cinemaTitleEl = root.querySelector('[data-momo-selected-cinema]');
    const cinemaAddressEl = root.querySelector('[data-momo-selected-address]');
    const params = new URLSearchParams(window.location.search);
    const isCinemaOnly = root.dataset.cinemaOnly === 'true';
    const isMovieDetail = window.location.pathname.includes('/phim/chi-tiet/');
    const requestedFilm = root.dataset.movieId || params.get('movie') || (isMovieDetail ? params.get('id') : null);
    const movieId = requestedFilm && /^[0-9]+$/.test(requestedFilm) ? requestedFilm : null;
    const knownMovies = new Set((root.dataset.knownMovies || '').split(','));
    const knownCinemas = new Set((root.dataset.knownCinemas || '').split(','));
    const base = import.meta.env.BASE_URL;
    const filmHref = (id) => knownMovies.has(String(id))
      ? moviePath(id, base)
      : base + 'phim/chi-tiet/?id=' + encodeURIComponent(id);
    const cinemaHref = (cinema) => knownCinemas.has(cinema.key)
      ? cinemaPath(cinema.chainId, cinema.apiCinemaId, base)
      : base + 'rap/chi-tiet/?cinema=' + encodeURIComponent(cinema.key);

    const state = {
      cinemas: [],
      chain: 0,
      district: '',
      query: '',
      selected: null,
      dayOffset: 0,
      sessionToken: 0
    };

    const esc = (value) => String(value ?? '').replace(/[&<>"']/g, (ch) => (
      { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[ch]
    ));

    function status(message, retry) {
      resultsEl.setAttribute('aria-busy', 'false');
      resultsEl.innerHTML = '';
      const p = document.createElement('p');
      p.className = 'momo-live__status';
      p.textContent = message;
      if (retry) {
        const button = document.createElement('button');
        button.type = 'button';
        button.textContent = 'Thử lại';
        button.addEventListener('click', retry);
        p.append(button);
      }
      resultsEl.append(p);
    }

    function skeletonResults(message) {
      resultsEl.innerHTML = `<div class="momo-live__loading-head skeleton" aria-hidden="true">
          <span class="skeleton__line" style="width:54%"></span>
          <span class="skeleton__line skeleton__line--short"></span>
        </div>
        <div class="momo-live__loading-programs" aria-hidden="true">
          ${Array.from({ length: 2 }, () => `<div class="momo-live__loading-program skeleton">
            <span class="momo-live__loading-poster"></span>
            <div class="momo-live__loading-content">
              <span class="skeleton__line" style="width:75%"></span>
              <span class="skeleton__line skeleton__line--short"></span>
              <div class="momo-live__loading-times">
                ${Array.from({ length: 4 }, () => '<span class="momo-live__loading-time"></span>').join('')}
              </div>
            </div>
          </div>`).join('')}
        </div>
        <p class="momo-live__status">${esc(message)}</p>`;
      resultsEl.setAttribute('aria-busy', 'true');
    }

    function renderChips() {
      const counts = new Map();
      for (const cinema of state.cinemas) counts.set(cinema.chainId, (counts.get(cinema.chainId) || 0) + 1);
      const chips = [[0, `Tất cả (${state.cinemas.length})`]];
      for (const [chainId, count] of [...counts.entries()].sort((a, b) => b[1] - a[1])) {
        chips.push([chainId, `${CHAINS[chainId] || 'Rạp'} (${count})`]);
      }
      chipsEl.innerHTML = chips.map(([id, label]) =>
        `<button type="button" class="momo-live__chip" data-chain="${id}" aria-pressed="${state.chain === id}">${esc(label)}</button>`
      ).join('');
      chipsEl.querySelectorAll('[data-chain]').forEach((button) => {
        const id = Number(button.dataset.chain);
        if (id) button.prepend(createChainLogo(id, CHAINS[id], 'momo-live__chain-logo'));
        else {
          const allMark = document.createElement('span');
          allMark.className = 'momo-live__chain-all';
          allMark.textContent = '✦';
          button.prepend(allMark);
        }
        button.addEventListener('click', () => {
          state.chain = Number(button.dataset.chain);
          const available = visibleCinemas();
          if (available.length && !available.some(item => item.key === state.selected)) {
            state.selected = available[0].key;
            loadSession();
          }
          renderChips();
          renderCinemas();
        });
      });
    }

    function normalize(value) {
      return String(value || '').normalize('NFD')
        .replace(/[\u0300-\u036f]/g, '').toLowerCase().trim();
    }
    // The upstream feed is currently scoped to HCM (apiCityId=50). Only
    // expose districts actually present in the returned cinema addresses.
    const districtPatterns = [
      { regex: /(?:\bquan|\bq\.)\s*(\d{1,2}|binh thanh|tan binh|tan phu|binh tan|go vap|phu nhuan)/i, prefix: 'Quận ' },
      { regex: /(?:\bhuyen|\bh\.)\s*(binh chanh|hoc mon|cu chi|nha be|can gio)/i, prefix: 'Huyện ' },
      { regex: /(?:\btp\.?|\bthanh pho)\s*(thu duc)/i, prefix: 'TP. ' }
    ];
    const areaNames = {
      'binh thanh': 'Bình Thạnh', 'tan binh': 'Tân Bình',
      'tan phu': 'Tân Phú', 'binh tan': 'Bình Tân',
      'go vap': 'Gò Vấp', 'phu nhuan': 'Phú Nhuận',
      'binh chanh': 'Bình Chánh', 'hoc mon': 'Hóc Môn',
      'cu chi': 'Củ Chi', 'nha be': 'Nhà Bè',
      'can gio': 'Cần Giờ', 'thu duc': 'Thủ Đức'
    };
    function districtFor(cinema) {
      const address = normalize(cinema.address || '');
      for (const {regex, prefix} of districtPatterns) {
        const match = address.match(regex);
        if (match) return prefix + (areaNames[match[1]] || match[1]);
      }
      return '';
    }
    function renderDistricts() {
      if (!districtEl || isCinemaOnly) return;
      const districts = [...new Set(state.cinemas.map(districtFor).filter(Boolean))].sort((a,b) => a.localeCompare(b, 'vi', {numeric:true}));
      districtEl.replaceChildren(new Option('Tất cả khu vực (' + state.cinemas.length + ')', ''), ...districts.map((name) => new Option(name, name)));
      if (districts.includes(state.district)) districtEl.value = state.district;
    }
    function visibleCinemas() {
      return state.cinemas.filter((cinema) =>
        (state.chain === 0 || cinema.chainId === state.chain) &&
        (!state.district || districtFor(cinema) === state.district) &&
        normalize(cinema.name + ' ' + cinema.address).includes(state.query)
      );
    }

    function renderCinemas() {
      const list = visibleCinemas();
      if (!list.length) {
        cinemasEl.innerHTML = '<p class="momo-live__status">Không tìm thấy rạp phù hợp.</p>';
        return;
      }
      cinemasEl.innerHTML = list.map((cinema) =>
        `<button type="button" class="momo-live__cinema" data-cinema="${esc(cinema.key)}" aria-current="${state.selected === cinema.key}">
           <span class="momo-live__cinema-info"><strong>${esc(cinema.name)}</strong><small>${esc(CHAINS[cinema.chainId] || '')} · ${esc(cinema.address)}</small></span>
         </button>`
      ).join('');
      cinemasEl.querySelectorAll('[data-cinema]').forEach((button) => {
        const cinema = state.cinemas.find((item) => item.key === button.dataset.cinema);
        if (cinema) button.prepend(createChainLogo(cinema.chainId, CHAINS[cinema.chainId], 'momo-live__list-logo'));
        button.addEventListener('click', () => {
          state.selected = button.dataset.cinema;
          const url = new URL(window.location.href);
          url.searchParams.set("cinema", state.selected);
          window.history.replaceState(null, "", url);
          renderCinemas();
          loadSession();
        });
      });
    }

    let currentShows = [];

    function renderSession(cinema, date, films) {
      if (!films.length) {
        currentShows = [];
        status(movieId ? `Phim này chưa có suất chiếu tại ${cinema.name} ngày ${date.split('-').reverse().join('/')}. Hãy thử rạp hoặc ngày khác.` : `${cinema.name} chưa có suất chiếu ngày ${date.split('-').reverse().join('/')}.`);
        return;
      }
      currentShows = [];
      const dateLabel = date.split('-').reverse().join('/');
      const programs = films.map((film) => {
        const groups = (film.VersionsCaptions || []).map((version) => {
          const times = (version.ShowTimes || []).map((show) => {
            const time = String(show.ShowTime || '').slice(11, 16);
            const idx = currentShows.push({
              show,
              filmTitle: film.Title,
              format: formatLabel(version),
              cinemaName: cinema.name,
              dateLabel,
              timeLabel: `${time}${show.ShowTimeDuration ? ` (${show.ShowTimeDuration})` : ''}`,
              screenName: show.ScreenName || ''
            }) - 1;
            return `<button type="button" class="showtime" data-show-idx="${idx}" title="Xem sơ đồ ghế suất ${esc(time)}">${esc(time)}</button>`;
          }).join('');
          return `<div class="program__format"><span class="program__format-label">${esc(formatLabel(version))}</span><div class="showtime-row">${times}</div></div>`;
        }).join('');
        const meta = [film.ApiGenreName, film.Duration ? `${film.Duration} phút` : '', film.ApiRatingFormat].filter(Boolean).join(' · ');
        return `<article class="program">
          <div class="momo-live__program-head">
            ${film.poster ? `<img class="momo-live__poster" src="${esc(film.poster)}" alt="" loading="lazy" />` : ''}
            <div class="momo-live__program-body">
              <div class="program__movie">
                <h3><a class="momo-live__film-link" href="${filmHref(film.Id)}">${esc(film.Title)}</a></h3>
                <p>${esc(meta)}</p>
              </div>
              ${groups}
            </div>
          </div>
        </article>`;
      }).join('');
      resultsEl.setAttribute('aria-busy', 'false');
      resultsEl.innerHTML = `<article class="theater-showtime">
        <header class="theater-showtime__header">
          <div><p class="eyebrow">${esc(CHAINS[cinema.chainId] || '')}</p><h3>${esc(cinema.name)}</h3><p>${esc(cinema.address)}</p>${isCinemaOnly ? '' : `<a class="momo-live__cinema-link" href="${cinemaHref(cinema)}">Chi tiết rạp ↗</a>`}</div>
          <span class="date-label">${esc(date.split('-').reverse().join('/'))}</span>
        </header>
        <div class="program-list">${programs}</div>
      </article>`;
      const heading = resultsEl.querySelector('.theater-showtime__header');
      if (heading) heading.prepend(createChainLogo(cinema.chainId, CHAINS[cinema.chainId], 'momo-live__head-logo'));
    }

    async function loadSession() {
      const cinema = state.cinemas.find((item) => item.key === state.selected);
      if (!cinema) return;
      const token = ++state.sessionToken;
      const date = saigonDate(state.dayOffset);
      if (cinemaTitleEl) cinemaTitleEl.textContent = cinema.name;
      if (cinemaAddressEl) cinemaAddressEl.textContent = cinema.address || 'TP. Hồ Chí Minh';
      skeletonResults(`Đang tải suất chiếu của ${cinema.name} ngày ${date.split('-').reverse().join('/')}…`);
      try {
        const data = await momoPost('/v2/cinema/session', {
          Cineplex: cinema.chainId,
          ApiCinemaId: cinema.apiCinemaId,
          Date: date,
          RecaptchaToken: ''
        });
        if (token !== state.sessionToken) return; // a newer selection won
        for (const film of data.Films || []) {
          film.poster = film.GraphicUrl || film.ImageUrl || '';
        }
        const films = movieId ? (data.Films || []).filter((film) => String(film.Id) === movieId) : (data.Films || []);
        renderSession(cinema, date, films);
      } catch (error) {
        if (token !== state.sessionToken) return;
        status(`Không tải được suất chiếu (${error.message}).`, loadSession);
      }
    }

    async function init() {
      cinemasEl.setAttribute('aria-busy', 'true');
      if (!isCinemaOnly) {
        cinemasEl.innerHTML = Array.from({ length: 5 }, () =>
          '<div class="momo-live__cinema-placeholder skeleton" aria-hidden="true"><span class="skeleton__line" style="width:73%"></span><span class="skeleton__line skeleton__line--short"></span></div>'
        ).join('');
        chipsEl.innerHTML = Array.from({ length: 4 }, () =>
          '<span class="momo-live__chip-placeholder skeleton" aria-hidden="true"></span>'
        ).join('');
      }
      skeletonResults('Đang cập nhật danh sách rạp và suất chiếu…');
      try {
        state.cinemas = await loadAllCinemas();
        cinemasEl.setAttribute('aria-busy', 'false');
        if (!state.cinemas.length) {
          cinemasEl.innerHTML = '';
          chipsEl.replaceChildren();
          status('Không có rạp nào cho ' + cityDisplayName(getCityId()) + '.', init);
          return;
        }
        const requestedCinema = root.dataset.cinemaKey || params.get("cinema");
        const foundCinema = state.cinemas.find((cinema) => cinema.key === requestedCinema);
        if (isCinemaOnly && !foundCinema) {
          cinemasEl.innerHTML = "";
          status("Không tìm thấy cụm rạp này. Hãy quay lại danh sách rạp để chọn một cụm rạp khác.");
          return;
        }
        state.selected = foundCinema ? foundCinema.key : state.cinemas[0].key;
        if (!isCinemaOnly) {
          renderDistricts();
          renderChips();
          renderCinemas();
        }
        loadSession();
      } catch (error) {
        cinemasEl.innerHTML = '';
        chipsEl.replaceChildren();
        cinemasEl.setAttribute('aria-busy', 'false');
        status(`Không tải được danh sách rạp (${error.message}).`, init);
      }
    }

    resultsEl.addEventListener('click', (event) => {
      const button = event.target.closest('[data-show-idx]');
      if (!button) return;
      const entry = currentShows[Number(button.dataset.showIdx)];
      if (!entry) return;
      window.dispatchEvent(new CustomEvent('eplus:open-seats', { detail: entry }));
    });
    searchEl.addEventListener('input', () => {
      state.query = normalize(searchEl.value);
      renderCinemas();
    });
    districtEl?.addEventListener('change', () => {
      state.district = districtEl.value;
      const available = visibleCinemas();
      if (available.length && !available.some(item => item.key === state.selected)) {
        state.selected = available[0].key;
        loadSession();
      }
      renderCinemas();
    });
    window.addEventListener('cinema:day', (event) => {
      state.dayOffset = Number(event.detail?.offset ?? event.detail ?? 0);
      loadSession();
    });

    function applyCityLabels() {
      const name = cityDisplayName(getCityId());
      if (cityNameEl) cityNameEl.textContent = name;
      if (cityNoteEl) cityNoteEl.textContent = 'Chỉ hiển thị rạp tại ' + name;
      document.querySelectorAll('[data-city-name]').forEach((el) => { el.textContent = name; });
    }
    if (cityEl) {
      cityEl.replaceChildren(...CITIES.map((city) =>
        new Option(city.id === 50 ? 'TP. ' + city.name : city.name, String(city.id))));
      cityEl.value = String(getCityId());
      cityEl.addEventListener('change', () => {
        setCityId(Number(cityEl.value));
        state.district = '';
        if (districtEl) districtEl.value = '';
        applyCityLabels();
        init();
      });
    }
    applyCityLabels();

    init();
  }
</script>
