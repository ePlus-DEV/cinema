---
import BaseLayout from '../../layouts/BaseLayout.astro';
import LiveCinemaGrid from '../../components/LiveCinemaGrid.astro';
---
<BaseLayout title="Hệ thống rạp chiếu | ePlus Cinema" active="cinemas">
  <section class="page-hero"><div class="container">
    <div class="breadcrumbs"><a href="/">Trang chủ</a><span>/</span><span>Rạp chiếu</span></div>
    <span class="eyebrow">CHỌN RẠP GẦN BẠN</span>
    <h1>Khám phá cụm rạp <span class="title-spark">✳</span></h1>
    <p>Tra cứu cụm rạp, địa chỉ và lịch chiếu cập nhật tại TP. Hồ Chí Minh.</p>
  </div></section>
  <section class="section container cinemas-page">
    <LiveCinemaGrid limit={200} searchable />
    <p class="catalog__footnote">Danh sách và địa chỉ rạp được tải từ nguồn MoMo Cinema; dữ liệu chỉ để tham khảo.</p>
  </section>
</BaseLayout>
