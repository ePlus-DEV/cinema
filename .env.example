# CORS proxy used by the live MoMo showtimes page (/lich-chieu/momo/).
# The MoMo Cinema API only sends CORS headers for www.momo.vn, so the browser
# calls it through this cors-anywhere style proxy: "<proxy>/<target URL>".
# PUBLIC_ variables are inlined into the client bundle at build time.
PUBLIC_MOMO_CORS_PROXY=https://xxx.com

# Search launch guard: false until content/source rights are confirmed.
# Production GitHub Actions reads vars.CINEMA_SEO_INDEXABLE; PR previews are always noindex.
SEO_INDEXABLE=false
